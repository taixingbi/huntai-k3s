{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Grafana Cloud hosted Prometheus / Mimir (same datasource you use for Explore)",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "smooth", "showPoints": "never" }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "label_replace(label_replace(label_replace(max by (node, model_name) (vllm:num_requests_running{workload=\"inference\", node=~\".+\"}), \"variant\", \"dpo\", \"model_name\", \".*dpo.*\"), \"variant\", \"sft\", \"model_name\", \".*sft.*\"), \"variant\", \"base\", \"model_name\", \"Qwen/.*\")",
          "legendFormat": "{{node}} {{variant}}",
          "refId": "A"
        }
      ],
      "title": "Running requests",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "smooth", "showPoints": "never" }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "label_replace(label_replace(label_replace(max by (node, model_name) (vllm:num_requests_waiting{workload=\"inference\", node=~\".+\"}), \"variant\", \"dpo\", \"model_name\", \".*dpo.*\"), \"variant\", \"sft\", \"model_name\", \".*sft.*\"), \"variant\", \"base\", \"model_name\", \"Qwen/.*\")",
          "legendFormat": "{{node}} {{variant}}",
          "refId": "A"
        }
      ],
      "title": "Waiting requests",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "smooth", "showPoints": "never" },
          "unit": "tps"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "label_replace(label_replace(label_replace(sum by (node, model_name) (rate(vllm:prompt_tokens_total{workload=\"inference\", node=~\".+\"}[1m])), \"variant\", \"dpo\", \"model_name\", \".*dpo.*\"), \"variant\", \"sft\", \"model_name\", \".*sft.*\"), \"variant\", \"base\", \"model_name\", \"Qwen/.*\")",
          "legendFormat": "{{node}} {{variant}} prompt tok/s",
          "refId": "A"
        }
      ],
      "title": "Prompt tokens / sec",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "smooth", "showPoints": "never" },
          "unit": "tps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "label_replace(label_replace(label_replace(sum by (node, model_name) (rate(vllm:generation_tokens_total{workload=\"inference\", node=~\".+\"}[1m])), \"variant\", \"dpo\", \"model_name\", \".*dpo.*\"), \"variant\", \"sft\", \"model_name\", \".*sft.*\"), \"variant\", \"base\", \"model_name\", \"Qwen/.*\")",
          "legendFormat": "{{node}} {{variant}} gen tok/s",
          "refId": "A"
        }
      ],
      "title": "Generation tokens / sec",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "smooth", "showPoints": "never" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "label_replace(label_replace(label_replace(histogram_quantile(0.99, sum(rate(vllm:time_to_first_token_seconds_bucket{workload=\"inference\", node=~\".+\"}[5m])) by (le, node, model_name)), \"variant\", \"dpo\", \"model_name\", \".*dpo.*\"), \"variant\", \"sft\", \"model_name\", \".*sft.*\"), \"variant\", \"base\", \"model_name\", \"Qwen/.*\")",
          "legendFormat": "{{node}} {{variant}} p99 TTFT",
          "refId": "A"
        }
      ],
      "title": "TTFT (p99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "smooth", "showPoints": "never" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "label_replace(label_replace(label_replace(histogram_quantile(0.99, sum(rate(vllm:e2e_request_latency_seconds_bucket{workload=\"inference\", node=~\".+\"}[5m])) by (le, node, model_name)), \"variant\", \"dpo\", \"model_name\", \".*dpo.*\"), \"variant\", \"sft\", \"model_name\", \".*sft.*\"), \"variant\", \"base\", \"model_name\", \"Qwen/.*\")",
          "legendFormat": "{{node}} {{variant}} p99 e2e",
          "refId": "A"
        }
      ],
      "title": "End-to-end latency (p99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "smooth", "showPoints": "never" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 7,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "label_replace(label_replace(label_replace(histogram_quantile(0.99, sum(rate(vllm:request_queue_time_seconds_bucket{workload=\"inference\", node=~\".+\"}[5m])) by (le, node, model_name)), \"variant\", \"dpo\", \"model_name\", \".*dpo.*\"), \"variant\", \"sft\", \"model_name\", \".*sft.*\"), \"variant\", \"base\", \"model_name\", \"Qwen/.*\")",
          "legendFormat": "{{node}} {{variant}} p99 queue",
          "refId": "A"
        }
      ],
      "title": "Queue time (p99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "smooth", "showPoints": "never" },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "id": 8,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "label_replace(label_replace(label_replace(max by (node, model_name) (vllm:gpu_cache_usage_perc{workload=\"inference\", node=~\".+\"}), \"variant\", \"dpo\", \"model_name\", \".*dpo.*\"), \"variant\", \"sft\", \"model_name\", \".*sft.*\"), \"variant\", \"base\", \"model_name\", \"Qwen/.*\")",
          "legendFormat": "{{node}} {{variant}} KV cache",
          "refId": "A"
        }
      ],
      "title": "KV cache usage (GPU)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "description": "huntai-k3s v3: per-GPU base/sft/dpo legends (model_name). Upstream: layer-observability-grafana dashboards/inference.json — sync via scripts/sync-grafana-dashboards.sh (fork; do not --apply-safe).",
  "tags": ["vllm", "inference", "qwen", "huntai-k3s:3"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "vLLM inference (Qwen)",
  "uid": "layer-vllm-inference",
  "version": 3
}
